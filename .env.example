# آدرس پایه سایت. خالی بذار تا خودکار از روی دامنه/مسیر تشخیص داده بشه؛
# اگه خواستی ثابتش کنی، مثلا: APP_URL=https://golara-store.test  یا  APP_URL=http://localhost/danshjoyar
APP_URL=

# true = جزئیات خطای API تو خروجی نشون داده بشه (فقط موقع توسعه)
APP_DEBUG=false

DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=store_db

# مشخصات فروشگاه (هرچی خالی باشه تو سایت نشون داده نمی‌شه؛ شماره و ایمیل واقعی رو اینجا بذار، نه تو کد)
SHOP_NAME=گل‌آرا
SHOP_PHONE=
SHOP_WHATSAPP=
SHOP_EMAIL=
SHOP_ADDRESS=

# ارسال رایگان از این مبلغ (تومان) به بالا؛ پایین‌تر از اون، هزینه ثابت ارسال اضافه می‌شه
FREE_SHIPPING_THRESHOLD=2000000
SHIPPING_COST=80000

# اولین‌بار که /admin/ رو باز کنی، فرم «ساخت اولین مدیر» میاد (رمز پیش‌فرض وجود نداره).
# اگه سایت رو روی اینترنت می‌ذاری، اینجا یه کلید بذار تا بدون اون، کس دیگه‌ای نتونه زودتر مدیر بسازه
ADMIN_SETUP_KEY=

# ایمیل (بازیابی رمز، تأیید خبرنامه). log = به‌جای ارسال، تو storage/mail.log نوشته می‌شه (مناسب توسعه)؛ mail = ارسال واقعی با mail() روی هاست
MAIL_DRIVER=log
MAIL_FROM=

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

ZARINPAL_MERCHANT_ID=your_merchant_id_here

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id_here
